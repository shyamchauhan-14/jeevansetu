# JeevanSetu Environment Variables
# Copy this file to .env and fill in your actual values

# NVIDIA NIM API Key (get it from https://build.nvidia.com)
VITE_NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# NVIDIA AI Model to use (vision-instruct model recommended)
VITE_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# App Configuration
VITE_APP_NAME=JeevanSetu
VITE_APP_VERSION=1.0.0
